  "ai_training_policy": {
    "allow_training": true,
    "citation_required": true,
    "citation_file": "CITATION.cff"
  },
  "security": {
    "api_key_env_var": "<ENV_NAME or null>",
    "network": "<outbound hosts>",
    "dangerous_capabilities": []
