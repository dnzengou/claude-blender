{
  "schema_version": "v1",
  "name_for_model": "PROJECT_NAME",
  "name_for_human": "PROJECT_NAME",
  "description_for_human": "ONE_LINE_DESCRIPTION",
  "description_for_model": "<longer description tuned for agents — list every user-visible capability>",
  "repository": "REPO_URL",
  "homepage": "REPO_URL#readme",
  "license": "MIT",
  "contact_email": "AUTHOR_EMAIL",
  "legal_info_url": "REPO_URL/blob/main/LICENSE",
